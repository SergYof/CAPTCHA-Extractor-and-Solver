{
  "manifest_version": 3,
  "name": "CAPTCHA Extractor Bridge",
  "version": "1.0",

  "permissions": ["scripting"],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.google.com/recaptcha/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}